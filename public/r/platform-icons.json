      "content": "import { h } from \"vue\"\nimport { registerCompanyIcons } from \"~/components/lifeline/company-registry\"\n\n/**\n * Platform marks for the hardware years.\n *\n * Paths are inlined from simple-icons (CC0 1.0), so there's no runtime\n * dependency. Trademarks remain their owners'; these are used here to\n * identify the hardware being described.\n *\n * Nintendo and Xbox are deliberately absent: simple-icons carries neither\n * (both have been delisted at the trademark holders' request), and rather\n * than ship a hand-drawn approximation of a logo everyone recognises,\n * those ids fall through to CompanyIcon's built-in initial-in-a-ring —\n * which is part of the component's own design, not a stand-in for one.\n */\n\n/**\n * `viewBox` defaults to the source's 24×24 square. The wordmarks (AMD,\n * Intel) sit as short, wide glyphs inset inside that square, so keeping\n * the square box and constraining height crushes them to a couple of\n * pixels — AMD rendered as a literal dash. Those pass a tight box\n * measured from the path's real getBBox, so the glyph fills its slot.\n */\nfunction brand(path: string, viewBox = \"0 0 24 24\") {\n  return (props: { class?: string }) =>\n    h(\n      \"svg\",\n      {\n        xmlns: \"http://www.w3.org/2000/svg\",\n        viewBox,\n        fill: \"currentColor\",\n        \"aria-hidden\": \"true\",\n        class: props.class,\n      },\n      [h(\"path\", { d: path })],\n    )\n}\n\nconst AppleIcon = brand(\n  \"M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.27